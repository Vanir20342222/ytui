  "source_only_cases": [
    {
      "name": "cookie",
      "args": [
        "--add-headers",
        "Cookie:fixture=value"
      ],
      "native_policy": "Native rejects raw Cookie compatibility loading; scoped Netscape/response cookies are separate",
      "expected_headers": {
        "cookie": "fixture=value"
      }
    },
    {
      "name": "unicode-name",
      "args": [
        "--add-headers",
        "X-É:fixture"
      ],
      "native_policy": "Native rejects non-ASCII header names even though source option regex accepts Unicode word characters",
      "expected_headers": {
        "x-é": "fixture"
      }
    },
    {
      "name": "embedded-newline",
      "args": [
        "--add-headers",
        "X-Test:one\r\ntwo"
      ],
      "native_policy": "Native rejects embedded CR/LF; source parser and HTTPHeaderDict alone do not enforce transport validity",
      "expected_headers": {
        "x-test": "one\r\ntwo"
      }
    }

  "request_cases": [
    {
      "name": "fixed-defaults",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {},
      "extractor": {},
      "expected_headers": {
        "user-agent": "Fixture-Default-UA",
        "accept": "*/*"
      }
    },
    {
      "name": "global-overrides-default",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "user-agent": "Global UA",
        "X-Test": "global"
      },
      "extractor": {},
      "expected_headers": {
        "user-agent": "Global UA",
        "accept": "*/*",
        "x-test": "global"
      }
    },
    {
      "name": "extractor-overrides-global",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "X-Test": "global",
        "Referer": "global-ref"
      },
      "extractor": {
        "x-TEST": "extractor",
        "referer": "page-ref"
      },
      "expected_headers": {
        "user-agent": "Fixture-Default-UA",
        "accept": "*/*",
        "x-test": "extractor",
        "referer": "page-ref"
      }
    },
    {
      "name": "extractor-user-agent",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "User-Agent": "Global UA"
      },
      "extractor": {
        "user-agent": "Site UA"
      },
      "expected_headers": {
        "user-agent": "Site UA",
        "accept": "*/*"
      }
    },
    {
      "name": "extractor-empty-remains",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "X-Test": "global"
      },
      "extractor": {
        "x-test": ""
      },
      "expected_headers": {
        "user-agent": "Fixture-Default-UA",
        "accept": "*/*",
        "x-test": ""
      }
    },
    {
      "name": "merge-trims-values",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "X-Global": "  global  "
      },
      "extractor": {
        "X-Site": "  site  "
      },
      "expected_headers": {
        "user-agent": "Fixture-Default-UA",
        "accept": "*/*",
        "x-global": "global",
        "x-site": "site"
      }
    },
    {
      "name": "cookie-removed",
      "defaults": {
        "User-Agent": "Fixture-Default-UA",
        "Accept": "*/*"
      },
      "global": {
        "Cookie": "fixture=value"
      },
      "extractor": {
        "cookie": "site=value"
      },
      "native_policy": "Source _calc_headers strips unscoped Cookie; native rejects raw user Cookie compatibility loading",
      "expected_headers": {
        "user-agent": "Fixture-Default-UA",
        "accept": "*/*"
      }
    }
